{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BLOB",
  "version": "0.1.0",
  "identifier": "com.blaiserailey.pace",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BLOB",
        "width": 1120,
        "height": 880,
        "minWidth": 420,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://i.scdn.co https://*.scdn.co https://*.spotifycdn.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Paces your day around your deadlines",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5ODUxQzFCMjRGNzZBOUMKUldTY2F2Y2tHeHlGaVJPVU9CcFAxdUJGSWxCSmdFaVdYY1dNWWEwZU01U2xEcThtdG5oRlBpVDYK",
      "endpoints": [
        "https://github.com/blaiserailey-lang/pace/releases/latest/download/latest.json"
      ]
    }
  }
}
